# Fast offline mode used by default.
COGNEE_PROVIDER=fake

# Real Cognee mode requires a provider key. Copy this file to .env and fill it in.
LLM_API_KEY=

# All Cognee and projection data remain inside this project.
PROJECTION_DATABASE=.local/projections.db
FAKE_DATASET_DIRECTORY=.local/fake-cognee
FAKE_RESULTS_PATH=data/fixtures/retriever/fake-results.json
